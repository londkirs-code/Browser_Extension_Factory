{
  "name": "browser-extension-factory",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26.0.0 <27",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "new": "tsx tools/new-extension.ts",
    "dev": "tsx tools/cli.ts dev",
    "dev:firefox": "tsx tools/cli.ts dev:firefox",
    "build": "tsx tools/cli.ts build",
    "build:all": "tsx tools/cli.ts build-all",
    "zip": "tsx tools/cli.ts zip",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "tsx tools/validate.ts",
    "validate:workflows": "tsx tools/validate-workflows.ts",
    "icons": "tsx tools/generate-icons.ts --all",
    "sign:firefox": "tsx tools/cli.ts sign:firefox",
    "publish:chrome": "tsx tools/cli.ts publish:chrome",
    "publish:firefox": "tsx tools/cli.ts publish:firefox"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.0.0",
    "eslint": "^10.14.0",
    "fflate": "^0.8.2",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0",
    "web-ext": "^10.8.0",
    "yaml": "^2.8.1"
  }
}
